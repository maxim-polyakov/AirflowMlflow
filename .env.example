# Neon: создайте две базы (airflow и mlflow) либо используйте два проекта.
# Спецсимволы в логине/пароле должны быть URL-encoded.
AIRFLOW_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/airflow?sslmode=require
MLFLOW_DATABASE_URL=postgresql://USER:PASSWORD@HOST/mlflow?sslmode=require

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_FERNET_KEY=PASTE_GENERATED_FERNET_KEY
AIRFLOW_WEBSERVER_SECRET_KEY=PASTE_LONG_RANDOM_STRING
AIRFLOW_UID=50000
AIRFLOW_PORT=8080

# Домены для системного Nginx на сервере.
AIRFLOW_DOMAIN=airflow.baxic.ru
MLFLOW_DOMAIN=mlflow.baxic.ru
MODEL_DOMAIN=model.baxic.ru

# AWS S3, Cloudflare R2, Selectel, MinIO и другие S3-compatible storage.
# Для AWS S3: https://s3.amazonaws.com
S3_ENDPOINT_URL=https://s3.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Airflow скачивает этот объект в /opt/airflow/data/input/.
DATA_BUCKET=my-data-bucket
DATA_OBJECT_KEY=dataset/train.csv

# Kafka Connect пишет сюда, Airflow проверяет prefix каждую минуту.
KAFKA_LOGS_BUCKET=kafkalogs
KAFKA_LOGS_PREFIX=storm-training/galaxy.storms/
KAFKA_LOGS_MAX_FILES_PER_RUN=100

# Данные из команды SSH в интерфейсе Vast.ai.
VAST_SSH_HOST=ssh-host.vast.ai
VAST_SSH_PORT=22
VAST_SSH_USER=root
VAST_SSH_STRICT_HOST_KEY=false
VAST_LOGS_PATH=/workspace/data/kafka-logs

# MLflow хранит артефакты здесь. Бакет может совпадать с DATA_BUCKET.
MLFLOW_ARTIFACT_BUCKET=my-mlflow-bucket
MLFLOW_ARTIFACT_PREFIX=artifacts
MLFLOW_PORT=5000

# Inference API автоматически загружает версию с alias production.
MODEL_NAME=stormmodel
MODEL_ALIAS=production
MODEL_POLL_SECONDS=60
MODEL_PORT=8000

